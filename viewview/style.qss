/* Graphite surfaces keep the photograph at the center of attention. */
QWidget {
    font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
    selection-background-color: #244b50;
    selection-color: #effffc;
}

MainWidget {
    color: #e3e9f0;
    background-color: #11151b;
}

FileManagementWidget {
    background-color: #191f28;
    border: 1px solid #2b3441;
    border-radius: 10px;
}

#filemanager-input {
    color: #c5d1de;
    background-color: #202936;
    border: 1px solid #303d4e;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    padding: 12px;
    margin: 8px 8px 0px 8px;
}

PathTreeWidget {
    color: #b9c5d3;
    show-decoration-selected: 0;
    background-color: #191f28;
    border: 1px solid #2b3441;
    border-radius: 9px;
    padding: 6px;
    outline: 0;
}

PathTreeWidget::item {
    color: #b9c5d3;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 10px 12px;
    margin: 2px 0px;
}

PathTreeWidget::item:hover {
    color: #f0f5fa;
    background-color: #242e3b;
    border-color: #354255;
}

PathTreeWidget::item:selected {
    color: #e6fff9;
    background-color: #223e43;
    border-color: #43887f;
}

PathTreeWidget::item:selected:!active {
    color: #d2e8e4;
    background-color: #263a40;
    border-color: #3b5b60;
}

PathTreeWidget::item:focus {
    border-color: #68b6a7;
}

ImageDisplayWidget {
    background-color: #0d1117;
    border: 1px solid #29323e;
    border-radius: 10px;
}

MetadataWidget {
    background-color: #191f28;
    border: 1px solid #2b3441;
    border-radius: 10px;
    padding: 14px 10px;
    margin: 0px;
}

MetadataWidget QLabel {
    background-color: transparent;
    border: none;
    padding: 7px 4px;
}

QLabel[role="title"] {
    color: #8f9eaf;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="description"] {
    color: #e3e9f0;
    font-size: 13px;
    font-weight: 400;
}

ToggleSplitter::handle {
    background: #344153;
    width: 12px;
    margin: 8px 2px;
    border: 1px solid #344153;
    border-radius: 4px;
}

ToggleSplitter::handle:hover {
    background: #425063;
}

ToggleSplitter::handle:pressed {
    background: #425063;
}

/* Keep every part of the Qt file chooser on a consistent dark palette. */
QFileDialog {
    color: #e3e9f0;
    background-color: #191f28;
}

QFileDialog QWidget {
    color: #e3e9f0;
    background-color: #191f28;
}

QFileDialog QAbstractItemView, QFileDialog QLineEdit, QFileDialog QComboBox {
    color: #e3e9f0;
    background-color: #11151b;
    border: 1px solid #425063;
    border-radius: 5px;
    selection-background-color: #244b50;
    selection-color: #effffc;
}

QFileDialog QLineEdit, QFileDialog QComboBox {
    padding: 6px;
}

QFileDialog QPushButton, QFileDialog QToolButton, QFileDialog QHeaderView::section {
    color: #e3e9f0;
    background-color: #263241;
    border: 1px solid #425063;
    border-radius: 4px;
    padding: 6px 10px;
}

QFileDialog QPushButton:hover, QFileDialog QToolButton:hover {
    background-color: #34485a;
    border-color: #68b6a7;
}

QFileDialog QPushButton:disabled, QFileDialog QToolButton:disabled {
    color: #8390a1;
    background-color: #202936;
}

QScrollBar:vertical {
    background-color: #191f28;
    width: 10px;
    margin: 3px 1px;
    border: none;
}

QScrollBar:horizontal {
    background-color: #191f28;
    height: 10px;
    margin: 1px 3px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #425063;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #425063;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background-color: #61758c;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolTip {
    color: #e3e9f0;
    background-color: #202936;
    border: 1px solid #425063;
    border-radius: 5px;
    padding: 6px 9px;
}

/* Tabs and import controls share the viewer's graphite palette. */
QTabWidget::pane {
    border: none;
    background-color: #11151b;
}

QTabBar::tab {
    color: #9eacbc;
    background-color: #191f28;
    border: 1px solid #2b3441;
    border-bottom: 2px solid transparent;
    padding: 10px 24px;
    margin-right: 3px;
}

QTabBar::tab:selected {
    color: #e6fff9;
    background-color: #202936;
    border-bottom-color: #68b6a7;
}

QTabBar::tab:hover {
    color: #effffc;
    background-color: #263241;
}

ImportWidget {
    background-color: #11151b;
}

ImportWidget QLabel {
    color: #b9c5d3;
    background: transparent;
}

#import-title {
    color: #e3e9f0;
    font-size: 22px;
    font-weight: 600;
}

#import-preview-title {
    color: #e3e9f0;
    font-size: 15px;
    font-weight: 600;
}

ImportWidget QLineEdit, ImportWidget QPlainTextEdit, ImportWidget QTreeWidget {
    color: #e3e9f0;
    background-color: #191f28;
    alternate-background-color: #1e2733;
    border: 1px solid #344153;
    border-radius: 6px;
    padding: 8px;
    selection-color: #effffc;
    selection-background-color: #244b50;
}

ImportWidget QLineEdit:focus {
    border-color: #68b6a7;
}

ImportWidget QLineEdit:read-only {
    color: #aebdcd;
    background-color: #151b23;
}

ImportWidget QHeaderView::section {
    color: #b9c5d3;
    background-color: #263241;
    border: none;
    border-bottom: 1px solid #425063;
    padding: 8px;
}

ImportWidget QTreeWidget::item {
    padding: 6px 4px;
}

ImportWidget QPushButton {
    color: #cbd8e5;
    background-color: #263241;
    border: 1px solid #425063;
    border-radius: 6px;
    padding: 8px 16px;
}

ImportWidget QPushButton:hover {
    background-color: #34485a;
    border-color: #68b6a7;
}

ImportWidget QPushButton:checked, #import-action {
    color: #e6fff9;
    background-color: #244b50;
    border-color: #43887f;
}

ImportWidget QPushButton:disabled {
    color: #778697;
    background-color: #191f28;
    border-color: #2b3441;
}

MetadataWidget QCheckBox {
    color: #e3e9f0;
    spacing: 8px;
    padding: 7px 4px;
}

MetadataWidget QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #61758c;
    border-radius: 4px;
    background-color: #11151b;
}

MetadataWidget QCheckBox::indicator:checked {
    background-color: #68b6a7;
    border-color: #8ed7c8;
}

MetadataWidget QCheckBox::indicator:hover {
    border-color: #8ed7c8;
}

MetadataWidget QCheckBox:disabled {
    color: #778697;
}

#review-error {
    color: #f2b3a7;
}

GridWidget {
    background-color: #11151b;
}

GridWidget QLabel {
    color: #aebdcd;
    background: transparent;
    padding: 4px;
}

ThumbnailView {
    color: #c5d1de;
    background-color: #0d1117;
    border: 1px solid #29323e;
    border-radius: 8px;
    padding: 8px;
    outline: 0;
}

ThumbnailView::item {
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 8px;
}

ThumbnailView::item:hover {
    background-color: #202936;
    border-color: #425063;
}

ThumbnailView::item:selected {
    color: #e6fff9;
    background-color: #223e43;
    border-color: #68b6a7;
}
